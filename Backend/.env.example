APP_NAME=RaktSaathi API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./raktsaathi.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cloudinary (optional until credentials are configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=raktsaathi
# Snowflake (optional; SQLite is the runnable local fallback)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
